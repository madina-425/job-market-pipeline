# Copy to .env and fill in. Never commit .env.

# ── AWS (required for full ETL) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET_NAME=

# Upload pipeline.log to S3 after each run (recommended in production)
UPLOAD_LOGS_TO_S3=true

# ── PostgreSQL (local Docker Compose OR AWS RDS) ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobmarket
DB_USER=pipeline_user
DB_PASSWORD=

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_ENV=development
LOG_LEVEL=INFO

# ── HeadHunter API ───────────────────────────────────────────────────────────
HH_USER_AGENT=JobMarketPipeline/1.0 (your-email@example.com)

# ── Optional ─────────────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
